generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  IT
  GURU
  DIRECTOR
  PARTNER
}

enum WorkflowStage {
  UPLOADED
  PENDING_DIRECTOR
  PENDING_PARTNERS
  PENDING_FINAL_DIRECTOR
  READY_FOR_IT
  COMPLETED
}

enum GuruDecision {
  BACKUP_AND_DELETE
  DELETE
  HOLD
}

enum ITStatus {
  PENDING
  STARTED_DOWNLOAD
  DELETED
  HOLD
  COMPLETED
}

enum PartnerReviewStatus {
  PENDING
  APPROVED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         Role     @default(EMPLOYEE)
  team         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Employee {
  id String @id @default(uuid())

  slNo Int

  name String

  emailId String

  team String

  workflowStage WorkflowStage @default(UPLOADED)

  guruCommentEmail GuruDecision?

  guruCommentOneDrive GuruDecision?

  statusByIT ITStatus @default(PENDING)

  directorApprovedAt DateTime?

  partnerAssignedAt DateTime?

  partnerReminderSent Boolean @default(false)

  completedAt DateTime?

  finalGuruComment String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  partnerApprovals PartnerApproval[]
}

model PartnerApproval {
  id String @id @default(uuid())

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id])

  partnerEmail String

  reviewerRole Role

  status PartnerReviewStatus @default(PENDING)

  emailDecision GuruDecision?

  oneDriveDecision GuruDecision?

  comment String?

  assignedAt DateTime @default(now())

  approvedAt DateTime?

  reminderSent Boolean @default(false)

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  employeeId String

  action String

  details String?

  performedBy String

  timestamp DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model License {
  id String @id @default(uuid())

  productName String

  assignedLicenses String

  availableLicenses String

  purchasedQuantity Int?

  purchaseDate DateTime?

  nextInvoiceDate DateTime?

  renewalDate DateTime?

  subscriptionStatus String

  notes String?

  updatedBy String?

  lastUpdatedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  renewalHistory LicenseRenewalHistory[]
}

model LicenseRenewalHistory {
  id String @id @default(uuid())

  licenseId String

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  oldRenewalDate DateTime?

  newRenewalDate DateTime

  notes String?

  updatedBy String?

  updatedAt DateTime @default(now())

  createdAt DateTime @default(now())
}