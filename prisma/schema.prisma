generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
  IT
  IT_HEAD
  GURU
  DIRECTOR
  PARTNER
}

enum WorkflowStage {
  UPLOADED
  PENDING_DIRECTOR
  PENDING_PARTNERS
  PENDING_FINAL_DIRECTOR
  READY_FOR_IT
  COMPLETED
}

enum GuruDecision {
  BACKUP_AND_DELETE
  DELETE
  HOLD
}

enum ITStatus {
  PENDING
  STARTED_DOWNLOAD
  DELETED
  HOLD
  COMPLETED
}

enum PartnerReviewStatus {
  PENDING
  APPROVED
}

enum LaptopStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  RETIRED
}

enum LaptopChangeRequestStatus {
  PENDING_IT_HEAD
  APPROVED
  REJECTED
  COMPLETED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         Role     @default(EMPLOYEE)
  team         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Employee {
  id String @id @default(uuid())

  slNo Int

  name String

  emailId String

  team String

  workflowStage WorkflowStage @default(UPLOADED)

  guruCommentEmail GuruDecision?

  guruCommentOneDrive GuruDecision?

  statusByIT ITStatus @default(PENDING)

  directorApprovedAt DateTime?

  partnerAssignedAt DateTime?

  partnerReminderSent Boolean @default(false)

  completedAt DateTime?

  finalGuruComment String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  batchName String?

  auditLogs AuditLog[]

  partnerApprovals PartnerApproval[]
}

model PartnerApproval {
  id String @id @default(uuid())

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id])

  partnerEmail String

  reviewerRole Role

  status PartnerReviewStatus @default(PENDING)

  emailDecision GuruDecision?

  oneDriveDecision GuruDecision?

  comment String?

  assignedAt DateTime @default(now())

  approvedAt DateTime?

  reminderSent Boolean @default(false)

  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())

  employeeId String

  action String

  details String?

  performedBy String

  timestamp DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model License {
  id String @id @default(uuid())

  productName String

  assignedLicenses String

  availableLicenses String

  purchasedQuantity Int?

  purchaseDate DateTime?

  nextInvoiceDate DateTime?

  renewalDate DateTime?

  subscriptionStatus String

  notes String?

  updatedBy String?

  lastUpdatedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  renewalHistory LicenseRenewalHistory[]
}

model LicenseRenewalHistory {
  id String @id @default(uuid())

  licenseId String

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  oldRenewalDate DateTime?

  newRenewalDate DateTime

  notes String?

  updatedBy String?

  updatedAt DateTime @default(now())

  createdAt DateTime @default(now())
}

model OnboardingEmployee {
  id String @id @default(uuid())

  employeeName String

  type String @default("ONBOARDING")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  tasks OnboardingTask[]

  auditLogs OnboardingAuditLog[]
}

model OnboardingTask {
  id String @id @default(uuid())

  onboardingEmployeeId String

  onboardingEmployee OnboardingEmployee @relation(fields: [onboardingEmployeeId], references: [id], onDelete: Cascade)

  slNo Int

  stage String

  taskName String

  assignedTo String?

  status String @default("Not Started")

  azureTeam String?

  seqriteTeam String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model OnboardingAuditLog {
  id String @id @default(uuid())

  onboardingEmployeeId String?

  onboardingEmployee OnboardingEmployee? @relation(fields: [onboardingEmployeeId], references: [id], onDelete: SetNull)

  employeeName String

  action String

  details String?

  performedBy String

  timestamp DateTime @default(now())
}

model OffboardingEmployee {
  id String @id @default(uuid())

  employeeName String

  team String?

  type String @default("OFFBOARDING")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  tasks OffboardingTask[]

  auditLogs OffboardingAuditLog[]
}

model OffboardingTask {
  id String @id @default(uuid())

  offboardingEmployeeId String

  offboardingEmployee OffboardingEmployee @relation(fields: [offboardingEmployeeId], references: [id], onDelete: Cascade)

  slNo Int

  stage String

  taskName String

  assignedTo String?

  status String @default("Not Started")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model OffboardingAuditLog {
  id String @id @default(uuid())

  offboardingEmployeeId String?

  offboardingEmployee OffboardingEmployee? @relation(fields: [offboardingEmployeeId], references: [id], onDelete: SetNull)

  employeeName String

  action String

  details String?

  performedBy String

  timestamp DateTime @default(now())
}

model LaptopInventory {
  id String @id @default(uuid())

  assetTag String @unique

  model String

  condition String

  location String

  status LaptopStatus @default(AVAILABLE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model LaptopChangeRequest {
  id String @id @default(uuid())

  currentAssetTag String
  currentUser String
  team String
  location String

  reasonForChange String

  newAssetTag String

  assignedToUser String

  requestedBy String

  status LaptopChangeRequestStatus @default(PENDING_IT_HEAD)

  itHeadComment String?

  approvedBy String?
  approvedAt DateTime?

  rejectedBy String?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs LaptopChangeAuditLog[]
}


model LaptopChangeAuditLog {
  id String @id @default(uuid())

  requestId String

  request LaptopChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  action String

  details String?

  performedBy String

  timestamp DateTime @default(now())
}
